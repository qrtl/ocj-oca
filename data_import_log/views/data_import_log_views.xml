<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Base views that should be extended as necessary. There is no action defined in
    this module. -->
    <record id="data_import_log_view_form" model="ir.ui.view">
        <field name="name">data.import.log.form</field>
        <field name="model">data.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Log" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="import_date" />
                            <field name="file_path" filename="file_name" />
                            <field name="file_name" invisible="1" />
                        </group>
                        <group>
                            <field name="model_id" />
                            <field name="model_name" invisible="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook string="Logs">
                        <page string="Error Lines" invisible="not error_ids">
                            <field name="error_ids">
                                <list>
                                    <field name="row_no" />
                                    <field name="reference" />
                                    <field name="error_message" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="data_import_log_view_list" model="ir.ui.view">
        <field name="name">data.import.log.list</field>
        <field name="model">data.import.log</field>
        <field name="arch" type="xml">
            <list
                create="false"
                edit="false"
                decoration-danger="state=='failed'"
                decoration-success="state=='done'"
            >
                <field name="import_date" />
                <field name="file_name" />
                <field name="model_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="data_import_log_view_search" model="ir.ui.view">
        <field name="name">data.import.log.select</field>
        <field name="model">data.import.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="file_name" />
                <field name="model_id" />
                <filter
                    name="filter_import_date"
                    string="Import Date"
                    date="import_date"
                />
                <separator />
                <filter name="state" string="Status" context="{'group_by':'state'}" />
                <filter
                    name="groupby_import_date"
                    string="Import Date"
                    context="{'group_by':'import_date'}"
                />
                <filter
                    name="model_id"
                    string="Model"
                    context="{'group_by':'model_id'}"
                />
            </search>
        </field>
    </record>
    <!-- This menu is to have a place to aggregate all the import history.
    Let users have access to the menu by assigning the 'Data Import Log' group
    to them as necessary. -->
    <menuitem
        id="data_import_main_menu"
        name="Data Import"
        groups="data_import_log.group_data_import_log"
    />
    <menuitem
        id="menu_data_import_log"
        name="Data Import"
        parent="data_import_main_menu"
        sequence="10"
    />
    <menuitem
        id="menu_data_import_setting"
        name="Data Import Settings"
        parent="data_import_main_menu"
        sequence="30"
        groups="base.group_system"
    />
</odoo>
