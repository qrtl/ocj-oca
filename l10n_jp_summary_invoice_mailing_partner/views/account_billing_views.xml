<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_billing_form" model="ir.ui.view">
        <field name="name">account.billing.form.mailing.partner</field>
        <field name="model">account.billing</field>
        <field
            name="inherit_id"
            ref="l10n_jp_summary_invoice.view_account_billing_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='remit_to_bank_id']" position="after">
                <field
                    name="invoice_mailing_partner_id"
                    invisible="bill_type != 'out_invoice'"
                />
            </xpath>
        </field>
    </record>
    <record id="view_billing_search" model="ir.ui.view">
        <field name="name">account.billing.search.mailing.partner</field>
        <field name="model">account.billing</field>
        <field name="inherit_id" ref="account_billing.view_billing_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="invoice_mailing_partner_id" />
            </xpath>
        </field>
    </record>
</odoo>
